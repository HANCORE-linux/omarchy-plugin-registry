<%# Icon-only copy control (Lucide `copy` / `check`, ISC license, inlined —
    no icon pipeline in this app). Lives inside a data-controller="clipboard"
    element carrying data-clipboard-text-value. %>
<button type="button" class="copy-button <%= local_assigns[:variant] %>"
        data-clipboard-target="button" data-action="clipboard#copy"
        aria-label="<%= label %>" title="<%= label %>">
  <svg class="copy-button__copy" viewBox="0 0 24 24" fill="none" stroke="currentColor"
       stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
  </svg>
  <svg class="copy-button__check" viewBox="0 0 24 24" fill="none" stroke="currentColor"
       stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 6 9 17l-5-5"/>
  </svg>
</button>
