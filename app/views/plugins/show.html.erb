<% content_for :title, "#{@plugin.full_name} — Omarchy Plugins" %>

<% if @plugin.security_holding? %>
  <div class="notice-banner notice-banner--danger">
    <strong>Security holding.</strong> This plugin was removed for malware and its name is permanently retired.
    Installed copies have been disabled via the revocation list.
  </div>
<% elsif @plugin.quarantined? %>
  <div class="notice-banner notice-banner--warning">
    <strong>Under review.</strong> This plugin is quarantined while our team investigates. It cannot be installed right now.
  </div>
<% elsif @latest.nil? && @versions.any? { |v| v.quarantined? || v.held? || v.processing? } %>
  <div class="notice-banner notice-banner--warning">
    <strong>Under review.</strong> No version of this plugin has cleared the review pipeline yet.
    Nothing is installable until one does.
  </div>
<% elsif @revoked %>
  <div class="notice-banner notice-banner--danger">
    <strong>Security notice.</strong> One or more versions of this plugin were revoked. Affected installs have been disabled.
  </div>
<% end %>

<div class="page-head">
  <div class="container">
    <p class="eyebrow"><%= @plugin.kinds.join(" · ") %></p>
    <h1><span class="ns"><%= link_to @publisher.name, publisher_path(@publisher.name) %>/</span><%= @plugin.name %></h1>
    <p class="summary"><%= @plugin.summary %></p>
    <div class="page-head__row">
      <% if @latest %><%= state_badge(:published) %><span class="muted">v<%= @latest.version %> · <%= @latest.license %></span><% end %>
      <span class="muted"><%= compact_number(@plugin.downloads_count) %> downloads · <%= compact_number(@plugin.views_count) %> views</span>
      <% if @plugin.average_rating %>
        <span class="rating-summary"><span class="diamond">◆</span> <%= @plugin.average_rating %>/5
          <span class="muted">(<%= @plugin.ratings_count %>)</span></span>
      <% end %>
    </div>
  </div>
</div>

<div class="plugin-layout container">
  <article>
    <div class="readme">
      <% if @plugin.readme.present? %>
        <%= render_markdown @plugin.readme %>
      <% else %>
        <p class="muted">No readme provided.</p>
      <% end %>
    </div>

    <section class="community">
      <h3>Community</h3>

      <% if authenticated? %>
        <%= form_with url: plugin_rating_path(@publisher.name, @plugin.name), class: "rate-widget" do %>
          <span class="eyebrow">Your rating</span>
          <% (1..5).each do |value| %>
            <button type="submit" name="value" value="<%= value %>"
              class="rate-diamond <%= "active" if @my_rating && value <= @my_rating.value %>"
              aria-label="Rate <%= value %> of 5">◆</button>
          <% end %>
        <% end %>
      <% end %>

      <% @comments.each do |comment| %>
        <div class="comment">
          <div class="comment__head">
            <strong><%= comment.user.name || "someone" %></strong>
            <% if comment.from_publisher? %><span class="badge">publisher</span><% end %>
            <span class="muted"><%= time_ago_in_words(comment.created_at) %> ago</span>
            <span class="comment__actions">
              <% if authenticated? && (comment.user == Current.user || Current.user.admin?) %>
                <%= button_to "delete", comment_path(comment), method: :delete, class: "linklike" %>
              <% end %>
              <% if authenticated? && comment.user != Current.user %>
                <%= button_to "report", reports_path(reportable_type: "Comment", reportable_id: comment.id, reason: "inappropriate"), class: "linklike" %>
              <% end %>
            </span>
          </div>
          <p><%= comment.body %></p>
        </div>
      <% end %>
      <p class="muted" style="margin-top: 12px;"><% if @comments.empty? %>No comments yet.<% end %></p>

      <% if authenticated? %>
        <%= form_with url: plugin_comments_path(@publisher.name, @plugin.name) do %>
          <div class="field">
            <label for="body">Add a comment</label>
            <textarea name="body" id="body" rows="3" required minlength="3" maxlength="2000"></textarea>
          </div>
          <button type="submit" class="button button--small">Post</button>
        <% end %>
      <% else %>
        <p class="muted"><%= link_to "Sign in", new_session_path %> to rate or comment.</p>
      <% end %>
    </section>
  </article>

  <aside class="sidebar">
    <section>
      <h4>Install</h4>
      <div class="install-cmd"><span class="prompt">$</span> omarchy plugin add <%= @plugin.full_name %></div>
    </section>
    <section>
      <h4>Details</h4>
      <dl>
        <dt>Plugin id</dt><dd><code><%= @plugin.manifest_id %></code></dd>
        <% if @latest %>
          <dt>Version</dt><dd><%= @latest.version %></dd>
          <dt>Published</dt><dd><%= time_ago_in_words(@latest.published_at) %> ago</dd>
          <dt>Size</dt><dd><%= number_to_human_size(@latest.size_bytes) %></dd>
          <dt>SHA-256</dt><dd><code><%= @latest.sha256.first(12) %>…</code></dd>
        <% end %>
        <% if @plugin.repository_url.present? %>
          <dt>Source</dt><dd><%= link_to @plugin.repository_url.sub(%r{\Ahttps?://}, ""), @plugin.repository_url %></dd>
        <% end %>
      </dl>
    </section>
    <% if @latest&.capability_fingerprint.present? %>
      <section>
        <h4>Capabilities</h4>
        <dl>
          <% @latest.capability_fingerprint.each do |cap, value| %>
            <dt><%= cap.humanize %></dt><dd><%= Array(value).join(", ") %></dd>
          <% end %>
        </dl>
      </section>
    <% end %>
    <% if @latest&.provenance.present? %>
      <section>
        <h4>Provenance</h4>
        <dl>
          <dt>Built from</dt>
          <dd><a href="https://github.com/<%= @latest.provenance["repository"] %>/commit/<%= @latest.provenance["sha"] %>"><%= @latest.provenance["repository"] %>@<%= @latest.provenance["sha"].to_s.first(7) %></a></dd>
          <dt>Workflow</dt><dd><code><%= @latest.provenance["workflow"].to_s.split("@").first.to_s.split("/").last %></code></dd>
          <dt>Via</dt><dd>OIDC trusted publishing</dd>
        </dl>
      </section>
    <% end %>
    <section>
      <h4>Versions</h4>
      <ul class="version-list">
        <% @versions.each do |version| %>
          <li>
            <span class="v"><%= version.version %></span>
            <span class="muted"><%= version.created_at.to_date %></span>
            <%= state_badge(version.state) unless version.published? %>
          </li>
        <% end %>
      </ul>
    </section>
  </aside>
</div>
