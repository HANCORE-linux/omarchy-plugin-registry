# Secrets referenced by config/deploy.yml. This file is committed — it must
# only ever contain lookups (env vars, file reads, secret-manager calls),
# never literal values. The files under .kamal/local/ are git-ignored; see
# docs/deploy.md for how each is generated.

# htpasswd password for the self-hosted image registry on the VM (user: kamal).
KAMAL_REGISTRY_PASSWORD=$(cat .kamal/local/registry_password)

# Decrypts config/credentials.yml.enc (provides secret_key_base).
RAILS_MASTER_KEY=$(cat config/master.key)

# Base64 32-byte Ed25519 seed — signs the index and kill list. Custody per the
# governance page; losing it means re-pinning every client.
REGISTRY_SIGNING_SEED=$(cat .kamal/local/signing_seed)

# Cloudflare R2 S3 credentials for Active Storage.
R2_ACCESS_KEY_ID=$(cat .kamal/local/r2_access_key_id)
R2_SECRET_ACCESS_KEY=$(cat .kamal/local/r2_secret_access_key)

# Cloudflare Tunnel token for the cloudflared accessory (public ingress).
TUNNEL_TOKEN=$(cat .kamal/local/tunnel_token)
